# === Java ===
*.class
*.jar
*.war
*.ear
build/
.gradle/
# Anchored patterns with internal slashes only match at the repo root, so this must be a
# **/-prefixed glob to also un-ignore services/gradle/wrapper/gradle-wrapper.jar (and any
# future Java module's wrapper jar, e.g. flink-jobs/) despite the blanket *.jar rule above.
!**/gradle/wrapper/gradle-wrapper.jar
out/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.eggs/
*.egg
.venv/
venv/

# === Node / Frontend ===
node_modules/
.next/
.turbo/
out/

# === IDE ===
.idea/
*.iml
.vscode/
*.swp
*.swo
.DS_Store

# === Claude Code (local-only settings) ===
.claude/settings.local.json
.claude/worktrees/

# === Environment ===
.env
.env.local
.env.*.local
!.env.example

# === Redis (contains dev password) ===
infrastructure/docker/redis/redis.conf
!infrastructure/docker/redis/redis.conf.example

# === Docker ===
docker-compose.override.yml

# === ML ===
*.pkl
*.joblib
*.h5
*.pt
*.pth
mlruns/
mlartifacts/

# === Misc ===
*.log
tmp/
coverage/
.coverage
htmlcov/
